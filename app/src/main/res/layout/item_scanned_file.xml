<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── 상단: 큰 미리보기 이미지 ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <!-- 미리보기 이미지 -->
            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#FFE8E8E8"
                android:contentDescription="@null" />

            <!-- 이미지 없을 때 플레이스홀더 -->
            <LinearLayout
                android:id="@+id/layoutPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFF5F5F5"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_pdf"
                    android:alpha="0.3"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="미리보기 없음"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- 하단 그라데이션 오버레이 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_bottom" />

            <!-- 페이지 수 배지 (우상단) -->
            <TextView
                android:id="@+id/tvPageBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:text="1페이지"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <!-- 파일 용량 (좌하단) -->
            <TextView
                android:id="@+id/tvFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:text="0 KB"
                android:textSize="11sp"
                android:textColor="#DDDDDD" />

        </FrameLayout>

        <!-- ── 하단: 파일 정보 + 버튼 ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <!-- 파일 정보 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="문서 이름"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024.01.01"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.45"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- OCR 버튼 (아이콘 + 텍스트 정사각형) -->
            <LinearLayout
                android:id="@+id/btnOcr"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="4dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_ocr"
                    android:tint="?attr/colorPrimary"
                    android:contentDescription="@null"
                    android:clickable="false"
                    android:focusable="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OCR"
                    android:textSize="9sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="false"
                    android:focusable="false" />

            </LinearLayout>

            <!-- 공유 버튼 -->
            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_share"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="공유"
                android:tint="?attr/colorOnSurface"
                android:alpha="0.5"
                android:layout_marginStart="2dp" />

            <!-- 삭제 버튼 -->
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="삭제"
                android:tint="@color/red_400"
                android:layout_marginStart="2dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
